{
  "name": "hhauto",
  "version": "8.1.5",
  "description": "Tampermonkey userscript automating the Harem Heroes game family",
  "main": "HHAuto.user.js",
  "scripts": {
    "test": "jest",
    "build": "webpack --config webpack.config.js",
    "lint": "eslint \"src/**/*.ts\" \"spec/**/*.ts\"",
    "lint:ci": "eslint \"src/**/*.ts\" \"spec/**/*.ts\" --max-warnings 1203",
    "typecheck": "tsc --noEmit",
    "deps:graph": "madge --extensions ts src",
    "deps:circular": "madge --circular --extensions ts src",
    "deps:circular:check": "node scripts/check-circular-deps.mjs",
    "deps:toplevel-key": "node scripts/check-toplevel-storage-key.mjs",
    "check:gm-grants": "node scripts/check-gm-grants.mjs",
    "deps:dead": "knip",
    "deps:unused": "depcheck --ignores=\"ts-jest,ts-node\"",
    "dup:check": "jscpd src --min-lines 10 --min-tokens 70 --reporters console,html --output ./coverage/jscpd",
    "bundle:stats": "webpack --config webpack.config.js --profile --json > stats.json",
    "bundle:analyze": "webpack-bundle-analyzer stats.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OldRon1977/HHauto.git"
  },
  "author": "OldRon1977 and contributors",
  "engines": { "node": ">=22" },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/OldRon1977/HHauto/issues"
  },
  "homepage": "https://github.com/OldRon1977/HHauto#readme",
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^4.0.1",
    "@types/tampermonkey": "^5.0.5",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.59.3",
    "depcheck": "^1.4.7",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jquery": "^4.0.0",
    "jscpd": "^5.0.11",
    "knip": "^6.24.0",
    "madge": "^8.0.0",
    "mock-local-storage": "^1.1.24",
    "source-map-loader": "^5.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.6.2",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "webpack-bundle-analyzer": "^5.3.0",
    "webpack-cli": "^7.2.1"
  }
}
